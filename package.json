{
  "name": "stackmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "npm run dev",
    "start": "electron .",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.cjs",
    "rebuild:native": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "smoke:desktop": "node scripts/smoke-desktop.cjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.575.0",
    "monaco-editor": "^0.55.1",
    "playwright-core": "^1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "productName": "StackMate",
  "description": "Desktop IDE with an integrated terminal and AI agent",
  "author": "StackMate contributors",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "icon": "electron/assets/icon.png",
    "appId": "com.stackmate.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/renderer/**",
      "electron/**",
      "terminal-server.cjs",
      "settings-store.cjs"
    ],
    "npmRebuild": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
